# Copy this file to .env and fill in real values. Never commit .env.

# Auth
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Encrypts database connection passwords at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-a-fernet-key

# LLM configuration — provider-agnostic, passed straight through to the text2sql
# framework's own TextSQL(model=, base_url=, verify_ssl=, extra_body=, llm_api_key=).
# Defaults below match the company's existing OpenAI-compatible endpoint (already the
# framework's own documented reference configuration) — leave as-is unless you're
# pointing at a different provider/deployment. No personal API key is required for the
# default endpoint; LLM_API_KEY only needs a value if your endpoint requires one.
LLM_MODEL=openai:Qwen/Qwen3.6-35B-A3B
LLM_BASE_URL=https://ibm-models.elsewedy-ec.com/v1
LLM_VERIFY_SSL=false
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LLM_API_KEY=

# Persistence
DATABASE_URL=sqlite:///./data/agentforge.db

# CORS — comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
